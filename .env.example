# Copy to .env.local for local development. Never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
APP_ORIGIN=http://localhost:3000
# Optional canonical public origin (HTTP or HTTPS, origin only). If unset, QR URLs use the request origin.
# Generate with: openssl rand -base64 32
QR_TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
# SMTP URL and sender are needed for password recovery in production.
SMTP_URL=smtps://USERNAME:PASSWORD@SMTP_HOST:465
EMAIL_FROM=BoxSave <support@example.com>
# Operator-only one-time bootstrap inputs; export only in the CLI shell when needed.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_PHONE=
